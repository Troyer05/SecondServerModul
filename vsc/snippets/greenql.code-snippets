{
  "Declare variable": {
    "prefix": [
      "declare",
      "var"
    ],
    "body": [
      "DECLARE _${1:name} = ${2:value};"
    ],
    "description": "Variable deklarieren"
  },
  "Declare constant": {
    "prefix": [
      "const",
      "declare const",
      "$"
    ],
    "body": [
      "DECLARE \\$${1:NAME} = ${2:value};"
    ],
    "description": "Konstante deklarieren"
  },
  "Declare param": {
    "prefix": [
      "param",
      "declare param"
    ],
    "body": [
      "DECLARE _${1:name} = param(\"${2:name}\");"
    ],
    "description": "Runtime-Parameter lesen"
  },
  "Output": {
    "prefix": [
      "output",
      "out"
    ],
    "body": [
      "OUTPUT(${1:_value});"
    ],
    "description": "Eintrag in den Output-Stream schreiben"
  },
  "Set logfile": {
    "prefix": [
      "setlog",
      "set logfile"
    ],
    "body": [
      "SET_LOGFILE(\"${1:logs/greenql.log}\");"
    ],
    "description": "Aktive Logdatei setzen"
  },
  "Log": {
    "prefix": [
      "log"
    ],
    "body": [
      "LOG(${1:_value});"
    ],
    "description": "Wert in aktive Logdatei schreiben"
  },
  "Clear log": {
    "prefix": [
      "clearlog"
    ],
    "body": [
      "CLEAR_LOG();"
    ],
    "description": "Aktive Logdatei leeren"
  },
  "Delete log file": {
    "prefix": [
      "deletelog"
    ],
    "body": [
      "DELETE_LOG_FILE();"
    ],
    "description": "Aktive Logdatei löschen"
  },
  "If else": {
    "prefix": [
      "if",
      "ifelse"
    ],
    "body": [
      "IF (${1:_value} == ${2:true}) {",
      "    ${3:OUTPUT(\"ok\");}",
      "} ELSE {",
      "    ${4:ERROR MSG \"not ok\";}",
      "}"
    ],
    "description": "IF / ELSE Block"
  },
  "For loop": {
    "prefix": "for",
    "body": [
      "FOR (_${1:item}; _${2:i} FROM _${3:items}) {",
      "    ${4:OUTPUT(_${1:item});}",
      "}"
    ],
    "description": "FOR Schleife"
  },
  "Map object": {
    "prefix": [
      "map",
      "map_object"
    ],
    "body": [
      "MAP_OBJECT(_${1:object} AS _${2:key}, _${3:value}) {",
      "    ${4:LOG(_${2:key});}",
      "}"
    ],
    "description": "Objekt/Array iterieren"
  },
  "Function": {
    "prefix": [
      "f",
      "function"
    ],
    "body": [
      "F ${1:myFunction}(_${2:value}) {",
      "    ${3:BACK _${2:value};}",
      "}"
    ],
    "description": "Funktion definieren"
  },
  "Restart function": {
    "prefix": [
      "restart",
      "this_f.restart"
    ],
    "body": [
      "this_f.restart();"
    ],
    "description": "Aktuelle Funktion neu starten"
  },
  "End proc": {
    "prefix": [
      "endproc",
      "end_proc"
    ],
    "body": [
      "END_PROC;"
    ],
    "description": "Script erfolgreich stoppen"
  },
  "Class": {
    "prefix": [
      "class",
      "c"
    ],
    "body": [
      "CLASS ${1:DemoService} {",
      "    PRIV DECLARE _name = \"${1:DemoService}\";",
      "",
      "    PUB F ${2:boot}() {",
      "        BACK this._name;",
      "    }",
      "}"
    ],
    "description": "greenQL Klasse"
  },
  "Call method": {
    "prefix": [
      "call",
      "callm"
    ],
    "body": [
      "CALL ${1:DemoService}/${2:boot}(${3});"
    ],
    "description": "Klassenmethode aufrufen"
  },
  "File include": {
    "prefix": [
      "file include",
      "include"
    ],
    "body": [
      "FILE.INCLUDE \"${1:scripts/include.gql}\";"
    ],
    "description": "Script im aktuellen Context ausführen"
  },
  "File run": {
    "prefix": [
      "file run",
      "run"
    ],
    "body": [
      "FILE.RUN \"${1:scripts/job.gql}\" WITH [\"${2:name}\": ${3:_value}];"
    ],
    "description": "Script separat ausführen"
  },
  "File back": {
    "prefix": [
      "file back",
      "file.back"
    ],
    "body": [
      "FILE.BACK ${1:_value};"
    ],
    "description": "Rückgabe aus FILE.RUN"
  },
  "Use instance": {
    "prefix": [
      "use instance",
      "usei"
    ],
    "body": [
      "USE INSTANCE ${1:main};"
    ],
    "description": "GBDBv2 Instance aktivieren"
  },
  "Root instance": {
    "prefix": [
      "root instance",
      "rooti"
    ],
    "body": [
      "ROOT INSTANCE ${1:main};"
    ],
    "description": "GBDBv2 Instance fokussieren"
  },
  "Grow instance": {
    "prefix": [
      "grow instance"
    ],
    "body": [
      "GROW INSTANCE ${1:main};"
    ],
    "description": "Instance erstellen"
  },
  "Drop instance force": {
    "prefix": [
      "drop instance"
    ],
    "body": [
      "DROP INSTANCE ${1:main} FORCE;"
    ],
    "description": "Instance löschen"
  },
  "Root base": {
    "prefix": [
      "root",
      "root base"
    ],
    "body": [
      "ROOT ${1:main};"
    ],
    "description": "Base setzen"
  },
  "Branch table": {
    "prefix": [
      "branch"
    ],
    "body": [
      "BRANCH ${1:users};"
    ],
    "description": "Aktive Tabelle setzen"
  },
  "Grow table": {
    "prefix": [
      "grow table",
      "table"
    ],
    "body": [
      "GROW TABLE ${1:users} (${2:uid, username, email});"
    ],
    "description": "Tabelle erstellen"
  },
  "Alter table add": {
    "prefix": [
      "alter add",
      "add column"
    ],
    "body": [
      "ALTER TABLE ${1:users} ADD ${2:created_at} DEFAULT ${3:NOW};"
    ],
    "description": "Spalte ergänzen"
  },
  "Pick": {
    "prefix": [
      "pick",
      "select"
    ],
    "body": [
      "PICK ${1:*} FROM ${2:users} WHERE ${3:uid} = ${4:_uid} SORT ${5:uid} ${6|ASC,DESC|} LIMIT ${7:10};"
    ],
    "description": "Daten lesen"
  },
  "Seed": {
    "prefix": [
      "seed",
      "insert"
    ],
    "body": [
      "SEED ${1:users} WITH uid=${2:_uid}, username=${3:_username}, active=TRUE;"
    ],
    "description": "Datensatz einfügen"
  },
  "Reshape": {
    "prefix": [
      "reshape",
      "update"
    ],
    "body": [
      "RESHAPE ${1:users} WITH ${2:active=TRUE} WHERE ${3:uid} = ${4:_uid};"
    ],
    "description": "Datensatz ändern"
  },
  "Erase": {
    "prefix": [
      "erase",
      "delete"
    ],
    "body": [
      "ERASE FROM ${1:users} WHERE ${2:uid} = ${3:_uid};"
    ],
    "description": "Datensatz löschen"
  },
  "Transaction": {
    "prefix": [
      "transaction",
      "begin"
    ],
    "body": [
      "BEGIN TRANSACTION;",
      "${1:# ...}",
      "COMMIT;"
    ],
    "description": "Transaktion"
  },
  "Exists data": {
    "prefix": [
      "exists data"
    ],
    "body": [
      "EXISTS DATA IN ${1:users} WHERE ${2:uid} = ${3:_uid};"
    ],
    "description": "Datensatz prüfen"
  },
  "Index": {
    "prefix": [
      "index"
    ],
    "body": [
      "INDEX ${1:users} (${2:uid});"
    ],
    "description": "Index anlegen"
  },
  "Constraint unique": {
    "prefix": [
      "unique"
    ],
    "body": [
      "CONSTRAINT ${1:users}.${2:uid} UNIQUE;"
    ],
    "description": "Unique Constraint"
  },
  "Fetch API": {
    "prefix": [
      "fetch_api",
      "api_fetch",
      "call_api"
    ],
    "body": [
      "fetch_api(${1:_url}, ${2:_body}, ${3:_headers})"
    ],
    "description": "Externe API abrufen"
  },
  "Unique id": {
    "prefix": [
      "uni_random",
      "spark_id",
      "fresh_id"
    ],
    "body": [
      "uni_random(${1:16})"
    ],
    "description": "Eindeutige Random-Zeichenkette"
  },
  "Showcase": {
    "prefix": [
      "showcase",
      "greenql showcase"
    ],
    "body": [
      "DECLARE \\$APP = \"greenQL\";",
      "DECLARE _uid = param(\"uid\");",
      "SET_LOGFILE(\"logs/demo.log\");",
      "LOG(\"start\");",
      "OUTPUT(\"greenQL started\");",
      "",
      "GROW INSTANCE demo;",
      "USE INSTANCE demo;",
      "ROOT INSTANCE demo;",
      "GROW BASE main;",
      "ROOT main;",
      "GROW TABLE users (uid, username, active);",
      "",
      "IF (EXISTS TABLE users) {",
      "    SEED users WITH uid=_uid, username=\"admin\", active=TRUE;",
      "    PICK * FROM users WHERE uid = _uid SORT uid ASC LIMIT 1;",
      "} ELSE {",
      "    ERROR MSG \"users table missing\";",
      "}",
      "",
      "CLEAR_LOG();"
    ],
    "description": "Großer mini Showcase"
  },
  "Monitor table": {
    "prefix": [
      "monitor",
      "gbdb monitor"
    ],
    "body": [
      "MONITOR ${1:main}.${2:users};"
    ],
    "description": "Monitoringdaten einer GBDB-Tabelle anzeigen"
  },
  "Recover table": {
    "prefix": [
      "recover",
      "wal recover"
    ],
    "body": [
      "RECOVER ${1:main}.${2:users};"
    ],
    "description": "WAL/Append-Recovery einer Tabelle ausführen"
  },
  "Cursor page": {
    "prefix": [
      "cursor",
      "gbdb cursor"
    ],
    "body": [
      "CURSOR ${1:main}.${2:users} SIZE ${3:100};"
    ],
    "description": "Cursor-basierten Tabellen-Slice laden"
  },
  "Page table": {
    "prefix": [
      "page",
      "gbdb page"
    ],
    "body": [
      "PAGE ${1:main}.${2:users} PAGE ${3:1} SIZE ${4:50};"
    ],
    "description": "Seitennavigation für Tabellen laden"
  },
  "Fulltext search": {
    "prefix": [
      "fulltext",
      "search"
    ],
    "body": [
      "FULLTEXT ${1:main}.${2:users} SEARCH \"${3:Max Muster}\" LIMIT ${4:50};"
    ],
    "description": "Volltextsuche über eine GBDB-Tabelle"
  },
  "Runtime instance_exists": {
    "prefix": [
      "instance_exists",
      "iexists"
    ],
    "body": [
      "DECLARE _exists = instance_exists(\"${1:default}\");"
    ],
    "description": "Prüft ob eine Instanz existiert"
  },
  "Runtime base_exists": {
    "prefix": [
      "base_exists",
      "bexists"
    ],
    "body": [
      "DECLARE _exists = base_exists(\"${1:main}\");"
    ],
    "description": "Prüft ob eine Base existiert"
  },
  "Runtime table_exists": {
    "prefix": [
      "table_exists",
      "texists"
    ],
    "body": [
      "DECLARE _exists = table_exists(\"${1:main}\", \"${2:users}\");"
    ],
    "description": "Prüft ob eine Tabelle existiert"
  },
  "Runtime data_exists": {
    "prefix": [
      "data_exists",
      "dexists"
    ],
    "body": [
      "DECLARE _exists = data_exists(\"${1:main}\", \"${2:users}\", [\"${3:email}\": \"${4:max@example.de}\"]);"
    ],
    "description": "Prüft ob Daten existieren"
  },
  "Runtime monitor": {
    "prefix": [
      "monitor()",
      "monitorfn"
    ],
    "body": [
      "DECLARE _monitor = monitor(\"${1:main}\", \"${2:users}\");"
    ],
    "description": "Monitoring als Funktion"
  },
  "Runtime recover": {
    "prefix": [
      "recover()",
      "recoverfn"
    ],
    "body": [
      "DECLARE _recovery = recover(\"${1:main}\", \"${2:users}\");"
    ],
    "description": "Recovery als Funktion"
  },
  "Runtime page": {
    "prefix": [
      "page()",
      "pagefn"
    ],
    "body": [
      "DECLARE _page = page(\"${1:main}\", \"${2:users}\", ${3:1}, ${4:50});"
    ],
    "description": "Page als Funktion"
  },
  "Runtime cursor": {
    "prefix": [
      "cursor()",
      "cursorfn"
    ],
    "body": [
      "DECLARE _cursor = cursor(\"${1:main}\", \"${2:users}\", ${3:100});"
    ],
    "description": "Cursor als Funktion"
  },
  "Runtime fulltext_search": {
    "prefix": [
      "fulltext_search",
      "ftsfn"
    ],
    "body": [
      "DECLARE _hits = fulltext_search(\"${1:main}\", \"${2:users}\", \"${3:Max Muster}\", [\"${4:username}\"], ${5:25});"
    ],
    "description": "Volltextsuche als Funktion"
  },
  "ENV": {
    "prefix": "ENV",
    "body": [
      "ENV(\"${1:api_auth}\")"
    ],
    "description": "Liest eine GreenQL ENV-Variable aus scripts/greenql/.ENV/.env.php."
  },
  "DECLARE ENV": {
    "prefix": "DECLARE ENV",
    "body": [
      "DECLARE _${1:api_auth} = ENV(\"${2:api_auth}\");"
    ],
    "description": "Deklariert eine Variable aus der GreenQL ENV-Datei."
  }
}